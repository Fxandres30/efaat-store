# Copiá este archivo a backend/.env y completá los valores reales.
# backend/.env NUNCA debe subirse a Git (ya está cubierto por el
# .gitignore de la raíz del proyecto, que ignora .env y .env.* en
# cualquier carpeta).

# URL del proyecto Supabase (la misma que usa el resto del proyecto).
SUPABASE_URL=

# Clave ADMINISTRATIVA de Supabase. NUNCA la publishable/anon key acá.
# Esta clave solo puede vivir en backend/ — nunca en el frontend, nunca
# en index.html, nunca en js/, nunca en un log ni en una respuesta HTTP.
#
# Supabase tiene dos generaciones de nombre para esta misma clave según
# la antigüedad del proyecto. Completá SOLO la que corresponda a tu
# dashboard (Project Settings → API Keys) — backend/config/env.js
# acepta cualquiera de las dos:
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=

# Puerto donde escucha el backend (opcional).
PORT=3001

# Orígenes permitidos por CORS en desarrollo, separados por coma.
# Por defecto acepta el index.html servido con `python3 -m http.server`
# tal como lo documenta el README del proyecto.
CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
